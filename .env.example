# Environment — copy to `.env` and fill in. Never commit `.env`.

PORT=8095
OG_BIND=127.0.0.1

# Required — your Ghost origin (no default)
GHOST_API_URL=

# Required — Ghost Admin API key as keyid:secret
GHOST_ADMIN_API_KEY=

# Card chrome
OG_SITE_TITLE=
OG_FOOTER_TEXT=
OG_FALLBACK_SUB=
# OG_LOGO_PATH=./assets/logo.svg

# Optional
# OG_CACHE_DIR=./cache
# OG_USER_AGENT=Mozilla/5.0 (compatible; OGCardService/1.0)
